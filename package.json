{
  "name": "etymon",
  "private": true,
  "version": "0.0.0",
  "description": "Étymon : dictionnaire du sens oublié",
  "type": "module",
  "scripts": {
    "dev": "npm run assembler && vite",
    "build": "npm run assembler && vite build",
