{
  "name": "etymon",
  "private": true,
  "version": "0.0.0",
  "description": "Étymon : dictionnaire du sens oublié",
  "type": "module",
  "scripts": {
    "dev": "node scripts/assembler-fiches.ts && vite",
    "build": "npm run assembler && vite build",
    "preview": "vite preview",
    "valider": "node scripts/valider-fiches.ts",
    "assembler": "node scripts/assembler-fiches.ts",
    "export": "node scripts/exporter.ts",
    "etat": "node scripts/etat.ts",
    "brouillons": "node scripts/etat.ts brouillons",
    "littre": "node --use-env-proxy scripts/littre.ts",
    "preparer": "node scripts/preparer-fiche.ts",
    "verifier": "node scripts/verifier-fiches.ts",
    "verifier:en-ligne": "node --use-env-proxy scripts/verifier-en-ligne.ts",
    "contrat": "node scripts/contrat.ts",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "prepare": "simple-git-hooks",
    "rediger": "node scripts/rediger-lot.ts",
    "dossier": "node --use-env-proxy scripts/dossier.ts",
    "bnf": "node --use-env-proxy scripts/bnf.ts",
    "texte": "node --use-env-proxy scripts/texte.ts",
    "liste": "node scripts/liste.ts",
    "corpus": "node --use-env-proxy scripts/corpus.ts",
    "lot": "node --use-env-proxy scripts/lot.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~7.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run valider"
  }
}
